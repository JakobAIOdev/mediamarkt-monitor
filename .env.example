# Delay between successful stock checks. Examples: 30s, 1m, 500ms.
CHECK_INTERVAL=30s

# Alert once per task after this many consecutive request/availability errors.
# Checks continue; a successful check sends a recovery alert.
ERROR_ALERT_THRESHOLD=5

# Default stock/health destination; a task's webhook_url can override it.
# Startup and process failure alerts always use this default webhook.
DISCORD_WEBHOOK_URL=
